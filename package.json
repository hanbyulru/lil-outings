{
  "name": "lil-outings",
  "version": "0.1.0",
  "description": "Aggregates kids' events and places for the Portland, OR metro",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "refresh": "node src/cli.js refresh",
    "refresh:demo": "node src/cli.js refresh --offline",
